# ═══════════════════════════════════════════════════════════════
# GOEIC Enterprise Assistant — App Image
#
# ✅ CUDA-enabled: embedding model + Whisper run on GPU
# ✅ Embedding model pre-baked into image (no download on startup)
# ✅ Whisper model pre-baked into image (no download on startup)
# ✅ FFmpeg included for Whisper audio processing
# ═══════════════════════════════════════════════════════════════

FROM nvidia/cuda:12.1.1-cudnn8-runtime-ubuntu22.04

ARG EMBEDDING_MODEL=paraphrase-multilingual-mpnet-base-v2
ARG WHISPER_MODEL_SIZE=base

ENV DEBIAN_FRONTEND=noninteractive

# ── System dependencies ───────────────────────────────────────
RUN apt-get update && apt-get install -y --no-install-recommends \
        python3.11 \
        python3.11-dev \
        python3-pip \
        python3.11-distutils \
        ffmpeg \
        libsndfile1 \
        libgomp1 \
        curl \
        git \
        ca-certificates \
    && ln -sf /usr/bin/python3.11 /usr/bin/python3 \
    && ln -sf /usr/bin/python3.11 /usr/bin/python \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# ── Step 1: pip + numpy FIRST ────────────────────────────────
# numpy must be installed before torch — torch links against it at import time
RUN pip install --no-cache-dir --upgrade pip setuptools wheel && \
    pip install --no-cache-dir "numpy>=1.24.0,<2.0.0"

# ── Step 2: PyTorch with CUDA 12.1 ───────────────────────────
RUN pip install --no-cache-dir \
        torch==2.2.2 \
        torchaudio==2.2.2 \
        --index-url https://download.pytorch.org/whl/cu121

# ── Step 3: Verify numpy+torch work together before continuing ──
RUN python3 -c "import numpy; import torch; print('numpy', numpy.__version__); print('torch', torch.__version__); import torch.nn"

# ── Step 4: App requirements ──────────────────────────────────
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# ── Step 5: Whisper ───────────────────────────────────────────
RUN pip install --no-cache-dir \
        "openai-whisper" \
        "numba>=0.57.0" \
        "llvmlite>=0.40.0"

# ── Copy application source ───────────────────────────────────
COPY main_offline.py .
COPY smart_scraper_offline.py .
COPY smart_excel_uploader_offline.py .
COPY smart_cleaner.py .
COPY public/ ./public/

# ── Pre-bake embedding model ──────────────────────────────────
RUN python3 -c "\
import os; \
os.environ['TRANSFORMERS_OFFLINE'] = '0'; \
from sentence_transformers import SentenceTransformer; \
print('Downloading embedding model: ${EMBEDDING_MODEL}'); \
SentenceTransformer('${EMBEDDING_MODEL}'); \
print('Embedding model ready'); \
"

# ── Pre-bake Whisper model ────────────────────────────────────
# numpy is now installed first so torch.from_numpy works correctly
RUN python3 -c "\
import numpy; \
import whisper; \
print('Downloading Whisper model: ${WHISPER_MODEL_SIZE}'); \
whisper.load_model('${WHISPER_MODEL_SIZE}'); \
print('Whisper model ready'); \
"

# ── Runtime directories ───────────────────────────────────────
RUN mkdir -p logs uploads

# ── Environment defaults ──────────────────────────────────────
ENV OLLAMA_HOST=http://ollama:11434
ENV OLLAMA_MODEL=qwen2.5:72b
ENV OLLAMA_TIMEOUT=300
ENV WEAVIATE_HOST=weaviate
ENV EMBEDDING_MODEL=paraphrase-multilingual-mpnet-base-v2
ENV WHISPER_MODEL_SIZE=base
ENV HF_HOME=/root/.cache/huggingface
ENV TRANSFORMERS_CACHE=/root/.cache/huggingface
ENV XDG_CACHE_HOME=/root/.cache
ENV NVIDIA_VISIBLE_DEVICES=all
ENV NVIDIA_DRIVER_CAPABILITIES=compute,utility
ENV PYTHONUNBUFFERED=1

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=15s --start-period=90s --retries=5 \
    CMD curl -f http://localhost:8000/health || exit 1

CMD ["python3", "-m", "uvicorn", "main_offline:app", \
     "--host", "0.0.0.0", "--port", "8000", \
     "--workers", "1", "--log-level", "info"]